---
import * as m from '@/paraglide/messages.js'
import { HREFLANG, HTML_LANG, LOCALES, type Locale } from '@/i18n/locales'
import { alternates, homePath } from '@/i18n/routes'
import LangSwitch from './LangSwitch.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  locale: Locale
  path: string
}

const { locale, path } = Astro.props
const alts = alternates(path)
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-bg focus:px-3 focus:py-2">
  {m.header_skip({}, { locale })}
</a>
<header class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 md:px-8">
  <a href={homePath(locale)} aria-label={m.header_home_label({}, { locale })} class="font-display text-lg font-semibold no-underline">
    Pedro Henrique
  </a>
  <div class="flex items-center gap-2">
    <LangSwitch locale={locale} path={path} />
    <ThemeToggle locale={locale} />
  </div>
</header>
<!-- Sugestão de idioma: o script mostra o grupo do idioma do navegador na primeira visita. -->
<aside data-lang-suggest data-locale={locale} hidden class="mx-auto max-w-6xl px-4 md:px-8">
  {
    LOCALES.filter((l) => l !== locale).map((l) => (
      <div data-suggest={l} lang={HTML_LANG[l]} hidden class="flex flex-wrap items-center gap-3 rounded-lg border border-line px-4 py-2">
        <a href={alts[l]} hreflang={HREFLANG[l]} data-suggest-link>
          {m.lang_suggest({}, { locale: l })}
        </a>
        <button type="button" data-suggest-dismiss class="underline">
          {m.lang_suggest_dismiss({}, { locale: l })}
        </button>
      </div>
    ))
  }
</aside>
