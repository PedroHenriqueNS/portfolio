---
import { Image } from 'astro:assets'
import * as m from '@/paraglide/messages.js'
import Base from '@/layouts/Base.astro'
import type { Locale } from '@/i18n/locales'
import { projectPath } from '@/i18n/routes'
import { getProjects } from '@/lib/projects'
import { formatPeriod, yearOf } from '@/lib/format'
import { homeSeo } from '@/lib/seo'
import { EXPERIENCES, xpKey } from '@/data/experiences'
import { SKILLS } from '@/data/skills'
import { CONTACTS } from '@/data/site'
import photo from '@/assets/images/pedro.jpg'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const projects = await getProjects(locale)
const featured = projects.filter((p) => p.featured)
const others = projects.filter((p) => !p.featured)

type Message = (inputs: Record<string, unknown>, options: { locale: Locale }) => string
/** Mensagem cuja chave é montada a partir dos dados (xp_*, cat_*, kind_*). */
const msg = (key: string, inputs = {}) => (m as unknown as Record<string, Message>)[key](inputs, { locale })

const RESUME = {
  pt: { href: '/curriculo_PedroHenrique.pdf', text: m.hero_cta_resume({}, { locale }), label: m.hero_cta_resume_label({}, { locale }) },
  en: { href: '/resume_PedroHenrique_EN.pdf', text: m.hero_cta_resume_en({}, { locale }), label: m.hero_cta_resume_en_label({}, { locale }) },
}
const resumes = locale === 'pt-br' ? [RESUME.pt, RESUME.en] : [RESUME.en, RESUME.pt]

// `**trecho**` na frase do Sobre vira <strong>: as partes ímpares do split.
const sentence = m.about_sentence({}, { locale }).split(/\*\*(.+?)\*\*/)
const EDUCATION = ['cs', 'telecom', 'english'] as const
const GROUPS = ['featured', 'frontend', 'backend'] as const
const kindLabel = (p: (typeof projects)[number]) => [msg(`kind_${p.kind}`), yearOf(p.date)].filter(Boolean).join(' · ')

const newTab = m.contact_new_tab({}, { locale })
const CONTACT_LINKS = [
  { text: m.contact_github({}, { locale }), ...CONTACTS.github, external: true },
  { text: m.contact_whatsapp({}, { locale }), ...CONTACTS.whatsapp, external: true },
  { text: m.contact_email({}, { locale }), ...CONTACTS.email, external: false },
  { text: m.contact_linkedin({}, { locale }), ...CONTACTS.linkedin, external: true },
]
---

<Base seo={homeSeo(locale, projects)} locale={locale}>
  <div class="mx-auto max-w-6xl space-y-24 px-4 pb-24 md:px-8">
    <section data-section="hero" id="hero" class="grid items-center gap-8 pt-8 md:grid-cols-[1fr_auto]">
      <div>
        <h1 class="font-display condensed text-6xl leading-none font-bold md:text-8xl">{m.hero_name({}, { locale })}</h1>
        <p class="mt-4 text-xl">{m.hero_role({}, { locale })}</p>
        <ul class="mt-8 flex flex-wrap gap-3">
          {
            resumes.map((r) => (
              <li>
                <a href={r.href} type="application/pdf" aria-label={r.label} class="inline-block rounded-full border border-line px-4 py-2">
                  {r.text}
                </a>
              </li>
            ))
          }
          <li>
            <a href="#contact" class="inline-block rounded-full border border-line px-4 py-2">{m.hero_cta_contact({}, { locale })}</a>
          </li>
        </ul>
      </div>
      <Image
        src={photo}
        alt={m.hero_photo_alt({}, { locale })}
        widths={[320, 640, 960]}
        sizes="(min-width: 768px) 320px, 80vw"
        loading="eager"
        class="h-auto w-full max-w-80 rounded-2xl"
      />
    </section>

    <section data-section="about" id="about" aria-labelledby="about-title">
      <h2 id="about-title" class="font-display text-3xl font-bold">{m.about_title({}, { locale })}</h2>
      <p class="mt-4 max-w-3xl text-2xl">
        {sentence.map((part, i) => (i % 2 ? <strong class="text-accent">{part}</strong> : part))}
      </p>
      <h3 class="sr-only">{m.edu_title({}, { locale })}</h3>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          EDUCATION.map((e) => (
            <li class="rounded-full border border-line px-4 py-2">
              <strong>{msg(`edu_${e}_label`)}</strong> <span>{msg(`edu_${e}_detail`)}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section data-section="experience" id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title" class="font-display text-3xl font-bold">{m.xp_title({}, { locale })}</h2>
      <ol class="mt-6 space-y-8">
        {
          EXPERIENCES.map((e) => (
            <li class="grid gap-2 md:grid-cols-[6rem_1fr]">
              <span class="font-display text-3xl font-bold">{e.year}</span>
              <div>
                <h3 class="text-xl font-semibold">
                  {msg(xpKey(e.id, 'role'))} · {e.company || msg(xpKey(e.id, 'company'))}
                  {e.current && <span class="ml-2 rounded-full border border-line px-2 text-sm font-normal">{m.xp_current({}, { locale })}</span>}
                </h3>
                <p class="text-sm">
                  {formatPeriod(e, locale)} · {e.location}
                </p>
                <p class="mt-2 max-w-3xl">{msg(xpKey(e.id, 'summary'))}</p>
                <p class="mt-2 text-sm">{e.stack.join(', ')}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section data-section="stage" id="stage" aria-labelledby="stage-title">
      <h2 id="stage-title" class="font-display text-3xl font-bold">{m.stage_title({}, { locale })}</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {
          featured.map((p) => (
            <li>
              <a data-project={p.slug} href={projectPath(locale, p.slug)} class="block rounded-2xl border border-line p-6 text-ink no-underline">
                <span class="font-display text-2xl font-bold">{p.title}</span>
                <span class="block text-sm">{kindLabel(p)}</span>
                <span class="mt-2 block">{p.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section data-section="projects" id="projects" aria-labelledby="projects-title">
      <h2 id="projects-title" class="font-display text-3xl font-bold">{m.list_title({}, { locale })}</h2>
      <ul class="mt-6 divide-y divide-line border-y border-line">
        {
          others.map((p) => (
            <li>
              <a data-project={p.slug} href={projectPath(locale, p.slug)} class="flex flex-wrap items-baseline justify-between gap-2 py-4 text-ink no-underline">
                <span class="text-xl font-semibold">{p.title}</span>
                <span class="text-sm">{kindLabel(p)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section data-section="skills" id="skills" aria-labelledby="skills-title">
      <h2 id="skills-title" class="font-display text-3xl font-bold">{m.skills_title({}, { locale })}</h2>
      <p class="mt-4">
        <strong>{m.skills_how_label({}, { locale })}:</strong> {m.skills_how({}, { locale })}
      </p>
      <div class="mt-6 grid gap-8 md:grid-cols-3">
        {
          GROUPS.map((g) => (
            <div>
              <h3 class="text-xl font-semibold">{msg(`skills_${g}`)}</h3>
              <ul class="mt-3 space-y-1">
                {SKILLS.filter((s) => s.group === g).map((s) => (
                  <li class="flex justify-between gap-4">
                    <span>
                      {s.title} <span class="text-sm">({msg(`cat_${s.category}`)})</span>
                    </span>
                    <span class="text-sm">{m.skills_level({ n: s.level }, { locale })}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section data-section="contact" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" class="font-display condensed text-5xl font-bold">{m.contact_title({}, { locale })}</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          CONTACT_LINKS.map((c) => (
            <li>
              <a href={c.href} {...(c.external && { target: '_blank', rel: 'noopener noreferrer' })} class="block rounded-xl border border-line p-4 no-underline">
                <span class="block font-semibold text-ink">{c.text}</span>
                <span class="block break-all">{c.label}</span>
                {c.external && <span class="sr-only">{newTab}</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          resumes.map((r) => (
            <li>
              <a href={r.href} type="application/pdf" aria-label={r.label} class="inline-block rounded-full border border-line px-4 py-2">
                {r.text}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
