---
// Único ponto dos ícones de interface: Lucide (ISC, https://lucide.dev) via @lucide/astro, renderizado no build,
// sem JavaScript no navegador. As marcas (GitHub, LinkedIn, WhatsApp) saíram do Lucide; seus traços ficam aqui,
// com o mesmo tamanho e traço dos demais. Logos de tecnologia (.tech-icon) não passam por aqui.
import {
  ArrowLeft, ArrowRight, ArrowUpRight, Building2, Calendar, Code, Download, ExternalLink, FileText, Globe, GraduationCap,
  House, Languages, Layers, LayoutGrid, LayoutTemplate, Lock, LockKeyhole, Mail, MapPin, Megaphone, MessageCircle, Monitor, Moon,
  Plus, RadioTower, Rocket, Server, Smartphone, Star, Sun, Workflow, X,
} from '@lucide/astro'

const LUCIDE = {
  'arrow-left': ArrowLeft, 'arrow-right': ArrowRight, 'arrow-up-right': ArrowUpRight, 'building-2': Building2,
  calendar: Calendar, code: Code, download: Download, 'external-link': ExternalLink, 'file-text': FileText, globe: Globe,
  'graduation-cap': GraduationCap, house: House, languages: Languages, layers: Layers, 'layout-grid': LayoutGrid,
  'layout-template': LayoutTemplate, lock: Lock, 'lock-keyhole': LockKeyhole, mail: Mail, 'map-pin': MapPin, megaphone: Megaphone,
  'message-circle': MessageCircle, monitor: Monitor, moon: Moon, plus: Plus, 'radio-tower': RadioTower, rocket: Rocket,
  server: Server, smartphone: Smartphone, star: Star, sun: Sun, workflow: Workflow, x: X,
}
const BRAND = {
  whatsapp: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
}

export type IconName = keyof typeof LUCIDE | keyof typeof BRAND

interface Props {
  name: IconName
  /** Lado do ícone; o padrão acompanha o texto. */
  size?: string
  /** Espaço de 0.4em: 'after' = depois do ícone (ícone antes do texto), 'before' = antes do ícone (ícone depois do texto). */
  space?: 'before' | 'after'
  class?: string
}

const { name, size = '1.1em', space, class: cls } = Astro.props
const cn = [space && (space === 'before' ? 'ic-before' : 'ic-after'), cls]
const common = { 'data-icon': name, 'aria-hidden': 'true' as const, width: size, height: size, class: cn }
const Lucide = name in LUCIDE ? LUCIDE[name as keyof typeof LUCIDE] : null
---

{
  Lucide ? (
    <Lucide {...common} class={cn.filter(Boolean).join(' ') || undefined} />
  ) : (
    <svg
      {...common}
      class={cn.filter(Boolean).join(' ') || undefined}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={BRAND[name as keyof typeof BRAND]}
    />
  )
}
