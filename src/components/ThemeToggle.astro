---
import * as m from '@/paraglide/messages.js'
import type { Locale } from '@/i18n/locales'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<button id="theme-toggle" type="button" aria-pressed="false" aria-label={m.theme_dark_label({}, { locale })} class="icon-button">
  <svg class="theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg class="theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const root = document.documentElement
  const sync = () => document.getElementById('theme-toggle')?.setAttribute('aria-pressed', String(root.classList.contains('dark')))

  document.addEventListener('astro:page-load', sync)
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('#theme-toggle')) return
    const dark = !root.classList.contains('dark')
    root.classList.add('theme-fade')
    root.classList.toggle('dark', dark)
    try {
      localStorage.setItem('data-theme', dark ? 'dark' : 'light')
    } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#060918' : '#EEF0F3')
    sync()
    setTimeout(() => root.classList.remove('theme-fade'), 300)
  })
</script>
