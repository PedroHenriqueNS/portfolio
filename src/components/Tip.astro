---
// Detalhe sob demanda: botão nativo de popover (teclado, toque e clique; nunca só hover).
// No desktop o cartão ancora no botão; abaixo de 768 px vira gaveta presa ao pé da tela.
// `hover`: abre também com o cursor em cima e com o foco. `class` troca o chip por um gatilho próprio (slot "trigger").
interface Props {
  label: string
  id: string
  hover?: boolean
  class?: string
}

const { label, id, hover = false, class: cls } = Astro.props
const tipId = `tip-${id}`
---

<button type="button" class={cls ?? 'tip-chip'} popovertarget={tipId} style={`anchor-name: --${tipId}`} data-tip-hover={hover ? '' : undefined}>
  {
    Astro.slots.has('trigger') ? (
      <slot name="trigger" />
    ) : (
      <>
        <span>{label}</span>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <path d="M8 3.5v9M3.5 8h9" />
        </svg>
      </>
    )
  }
</button>
<div id={tipId} popover class="tip-card" style={`position-anchor: --${tipId}`}>
  <p class="tip-title">{label}</p>
  <div class="tip-body"><slot /></div>
</div>

<script>
  // Hover e foco abrem os gatilhos `data-tip-hover`; o clique (toque) continua com o popovertarget nativo.
  // No documento: sobrevive às trocas do ClientRouter e vale sem motion.
  const trigger = (t: EventTarget | null) => (t as Element | null)?.closest?.<HTMLButtonElement>('[data-tip-hover]') ?? null
  const card = (b: HTMLButtonElement) => b.popoverTargetElement as HTMLElement | null
  const open = (b: HTMLButtonElement) => {
    const c = card(b)
    if (!c || c.matches(':popover-open')) return
    c.showPopover()
    // O clique que vem logo depois (mouse, Enter, toque que focou) não deve fechar o que acabou de abrir.
    b.dataset.tipAuto = ''
  }
  const close = (b: HTMLButtonElement) => {
    delete b.dataset.tipAuto
    const c = card(b)
    if (c?.matches(':popover-open')) c.hidePopover()
  }
  const fine = matchMedia('(hover: hover) and (pointer: fine)')
  document.addEventListener('pointerover', (e) => {
    const b = trigger(e.target)
    if (b && e.pointerType === 'mouse' && fine.matches) open(b)
  })
  document.addEventListener('pointerout', (e) => {
    const b = trigger(e.target)
    if (b && e.pointerType === 'mouse' && !b.contains(e.relatedTarget as Node) && !b.matches(':focus-visible')) close(b)
  })
  document.addEventListener('focusin', (e) => {
    const b = trigger(e.target)
    if (b) open(b)
  })
  document.addEventListener('focusout', (e) => {
    const b = trigger(e.target)
    if (b && !b.matches(':hover')) close(b)
  })
  document.addEventListener('click', (e) => {
    const b = trigger(e.target)
    if (b && 'tipAuto' in b.dataset) {
      e.preventDefault()
      delete b.dataset.tipAuto
    }
  })
</script>

<style>
  .tip-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border: 1px solid var(--line);
    border-radius: 9999px;
    font: 500 0.9375rem/1 var(--font-sans);
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    cursor: pointer;
    touch-action: manipulation;
    transition: border-color 200ms ease, background-color 200ms ease;
  }
  .tip-chip svg { transition: rotate 250ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .tip-chip:hover { border-color: var(--ink); }
  .tip-chip:has(+ :popover-open) { border-color: var(--accent); }
  .tip-chip:has(+ :popover-open) svg { rotate: 45deg; }

  .tip-card {
    margin: 0;
    inset: auto 0.75rem 0.75rem;
    width: auto;
    max-width: none;
    padding: 1rem 1.25rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--bg);
    color: var(--ink);
    /* Explícito: o gatilho pode estar dentro de tipo gigante (as faixas de skills). */
    font: 400 0.9375rem / 1.45 var(--font-sans);
    font-stretch: normal;
    letter-spacing: normal;
    white-space: normal;
    box-shadow: 0 24px 48px -24px var(--shadow);
    opacity: 0;
    translate: 0 0.75rem;
    transition: opacity 200ms ease, translate 250ms cubic-bezier(0.2, 0.8, 0.2, 1), overlay 250ms allow-discrete, display 250ms allow-discrete;
  }
  .tip-card:popover-open { opacity: 1; translate: 0 0; }
  @starting-style {
    .tip-card:popover-open { opacity: 0; translate: 0 0.75rem; }
  }
  .tip-title { margin-bottom: 0.25rem; font-weight: 600; }
  .tip-body { color: var(--muted); }

  @media (min-width: 768px) {
    @supports (position-area: top) {
      .tip-card {
        inset: auto;
        position-area: top span-right;
        position-try-fallbacks: flip-block;
        margin: 0 0 0.625rem;
        max-width: 22rem;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tip-card, .tip-card:popover-open { translate: none; }
  }
</style>
