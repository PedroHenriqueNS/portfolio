---
import * as m from '@/paraglide/messages.js'
import type { Locale } from '@/i18n/locales'
import { CONTACTS } from '@/data/site'
import Icon from '@/components/Icon.astro'

interface Props {
  locale: Locale
  resumes: { href: string; text: string; label: string }[]
}

const { locale, resumes } = Astro.props
const title = m.contact_title({}, { locale })
// Celular: a frase em duas linhas (primeira palavra e o resto); o tamanho sai da linha mais longa.
const [first, ...rest] = title.split(' ')
const lines = rest.length ? [first, rest.join(' ')] : [first]
const longest = Math.max(...lines.map((l) => l.length))
const newTab = m.contact_new_tab({}, { locale })
const year = new Date().getFullYear()

const ICON = { whatsapp: 'whatsapp', email: 'mail', linkedin: 'linkedin', github: 'github' } as const
const LINKS = [
  { key: 'whatsapp', text: m.contact_whatsapp({}, { locale }), href: CONTACTS.whatsapp.href, external: true },
  { key: 'email', text: m.contact_email({}, { locale }), href: CONTACTS.email.href, external: false },
  { key: 'linkedin', text: m.contact_linkedin({}, { locale }), href: CONTACTS.linkedin.href, external: true },
  { key: 'github', text: m.contact_github({}, { locale }), href: CONTACTS.github.href, external: true },
] as const
---

<section data-section="contact" id="contact" class="ct" aria-labelledby="contact-title">
  <div class="ct-horizon" aria-hidden="true"><i></i></div>
  <div class="ct-body" style={`--chars: ${title.length}; --longest: ${longest}`}>
    <h2 id="contact-title" class="ct-title" data-fit>
      {lines.map((l) => <span class="ct-line">{l}</span>)}
    </h2>
    <ul class="ct-links">
      {
        LINKS.map((c, i) => (
          <li>
            <a
              href={c.href}
              data-contact={c.key}
              class:list={['ct-link', { 'ct-link-main': i === 0 }]}
              {...(c.external && { target: '_blank', rel: 'noopener noreferrer' })}
            >
              <Icon name={ICON[c.key]} size="20px" />
              <span>{c.text}</span>
              {c.external && <span class="sr-only">{newTab}</span>}
              <Icon name="arrow-up-right" size="18px" class="ct-arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <footer class="ct-foot">
    <ul class="ct-resumes">
      {
        resumes.map((r, i) => (
          <li>
            <a href={r.href} type="application/pdf" aria-label={r.label} data-astro-reload class="ct-resume">
              <Icon name={i === 0 ? 'download' : 'file-text'} space="after" />{r.text}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="ct-copy">{m.footer_copyright({ year: String(year) }, { locale })}</p>
  </footer>
</section>

<style>
  .ct {
    /* Faixa de baixo, já dentro do horizonte: onde fica o rodapé. */
    --rise: clamp(9rem, 24svh, 14rem);
    --seam: clamp(240px, 36svh, 380px);
    --glass: color-mix(in srgb, var(--closing-ink) 8%, transparent);
    --glass-line: color-mix(in srgb, var(--closing-ink) 30%, transparent);
    /* Véu de cobalto da emenda: sobre o fundo escuro ele vira faixa, então é mais fraco no tema escuro. */
    --tint: 22%;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    /* A emenda ocupa a margem: nunca cobre o conteúdo da seção de cima. */
    margin-top: var(--seam);
    padding: 14svh var(--gutter) 0;
    background: var(--closing);
    color: var(--closing-ink);
    /* Sem overflow: hidden aqui, que cortaria a emenda; quem recorta é .ct-horizon. */
    overflow-x: clip;
    overflow-y: visible;
  }
  :global(html.dark) .ct { --tint: 7%; }
  .ct :focus-visible { outline-color: var(--closing-ink); }

  /* Emenda: do fundo do tema (transparente) à cor do fecho numa curva suave (sem faixa visível), com um véu de
     cobalto no meio que o escuro engole no fim. Sem borda reta. */
  .ct::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: var(--seam);
    pointer-events: none;
    background:
      linear-gradient(
        to bottom,
        transparent,
        color-mix(in srgb, var(--closing) 3%, transparent) 20%,
        color-mix(in srgb, var(--closing) 11%, transparent) 36%,
        color-mix(in srgb, var(--closing) 25%, transparent) 50%,
        color-mix(in srgb, var(--closing) 45%, transparent) 63%,
        color-mix(in srgb, var(--closing) 68%, transparent) 76%,
        color-mix(in srgb, var(--closing) 88%, transparent) 89%,
        var(--closing)
      ),
      linear-gradient(
        to bottom,
        transparent,
        color-mix(in srgb, var(--accent) calc(var(--tint) * 0.6), transparent) 40%,
        color-mix(in srgb, var(--accent) var(--tint), transparent) 70%,
        transparent
      );
  }

  /* Horizonte: um círculo enorme cuja borda de cima é a linha de luz. */
  .ct-horizon {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  /* O i é o círculo com a aura em volta (gradiente radial: um box-shadow de 240 px de desfoque sai em blocos no
     Chromium); o ::before é o próprio círculo, com a linha de luz. */
  .ct-horizon i {
    --d: 240vmax;
    --glow: 20vmax;
    position: absolute;
    left: 50%;
    top: calc(100% - var(--rise) - var(--glow));
    width: calc(var(--d) + 2 * var(--glow));
    aspect-ratio: 1;
    margin-left: calc(var(--d) / -2 - var(--glow));
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      color-mix(in srgb, var(--accent) 55%, transparent) calc(var(--d) / 2),
      color-mix(in srgb, var(--accent) 22%, transparent) calc(var(--d) / 2 + var(--glow) * 0.3),
      color-mix(in srgb, var(--accent) 6%, transparent) calc(var(--d) / 2 + var(--glow) * 0.65),
      transparent calc(var(--d) / 2 + var(--glow))
    );
  }
  .ct-horizon i::before {
    content: "";
    position: absolute;
    inset: var(--glow);
    border-radius: 50%;
    background: var(--closing-deep);
    box-shadow:
      0 0 0 1.5px color-mix(in srgb, var(--accent-2) 55%, var(--closing-ink)),
      0 0 40px 3px var(--accent-2);
  }

  .ct-body {
    --fit: 0.415;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(2rem, 6svh, 3.5rem);
    padding-bottom: 6svh;
    container-type: inline-size;
  }
  .ct-title {
    margin: 0;
    font: 700 min(13cqw, calc(100cqw / (var(--chars) * var(--fit)))) / 0.88 var(--font-display);
    font-stretch: 75%;
    letter-spacing: -0.015em;
    text-align: center;
    white-space: nowrap;
  }
  .ct-line + .ct-line::before { content: " "; }

  .ct-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .ct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 3.5rem;
    padding: 0 1.5rem;
    border: 1px solid var(--glass-line);
    border-radius: 9999px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font: 500 1rem/1 var(--font-sans);
    color: var(--closing-ink);
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .ct-link:hover { background: color-mix(in srgb, var(--closing-ink) 16%, transparent); border-color: var(--closing-ink); }
  .ct-link-main { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .ct-link-main:hover { background: var(--closing-ink); border-color: var(--closing-ink); color: var(--closing); }
  :global(.ct-arrow) { display: none; }

  .ct-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    min-height: var(--rise);
    padding: 3rem 0 1.5rem;
    align-content: end;
  }
  .ct-resumes { display: flex; gap: 0.25rem; }
  .ct-resume {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    border-radius: 9999px;
    font: 500 0.875rem/1 var(--font-sans);
    color: var(--closing-ink);
    text-decoration: underline;
    text-decoration-color: var(--glass-line);
    transition: background-color 200ms ease;
  }
  .ct-resume:hover { background: var(--glass); }
  .ct-copy { font-size: 0.8125rem; color: color-mix(in srgb, var(--closing-ink) 68%, var(--closing-deep)); }

  @media (max-width: 767.98px) {
    .ct {
      --rise: clamp(8rem, 20svh, 11rem);
      --seam: clamp(200px, 30svh, 300px);
      padding-top: 12svh;
    }
    .ct-horizon i { --d: 220vw; --glow: 40vw; }
    .ct-body { --fit: 0.45; justify-items: stretch; gap: 2.5rem; padding-bottom: 4svh; }
    .ct-title { font-size: min(30cqw, calc(100cqw / (var(--longest) * var(--fit)))); }
    .ct-line { display: block; }
    .ct-line + .ct-line::before { content: none; }
    .ct-links { display: grid; grid-template-columns: 100%; gap: 0.5rem; }
    .ct-link { width: 100%; height: 3.5rem; padding: 0 1.25rem; gap: 0.875rem; }
    :global(.ct-arrow) { display: block; margin-left: auto; opacity: 0.7; }
    .ct-foot { flex-direction: column; flex-wrap: nowrap; justify-content: end; align-items: center; text-align: center; }
  }
</style>
