---
import { Image } from 'astro:assets'
import * as m from '@/paraglide/messages.js'
import type { Locale } from '@/i18n/locales'
import { EXPERIENCES, xpKey } from '@/data/experiences'
import { TECH } from '@/data/tech'
import { formatPeriod } from '@/lib/format'
import Drawer from '@/components/Drawer.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
type Message = (inputs: Record<string, unknown>, options: { locale: Locale }) => string
const msg = (key: string) => (m as unknown as Record<string, Message>)[key]({}, { locale })

const icons = new Map(Object.values(TECH).map((t) => [t.title, t.icon]))
const items = EXPERIENCES.map((e) => ({
  ...e,
  company: e.company || msg(xpKey(e.id, 'company')),
  role: msg(xpKey(e.id, 'role')),
  summary: msg(xpKey(e.id, 'summary')),
  period: formatPeriod(e, locale),
  stack: e.stack.map((name) => ({ name, icon: icons.get(name) })),
}))
const current = m.xp_current({}, { locale })
const openLabel = m.xp_open({}, { locale })
const closeLabel = m.xp_close({}, { locale })
---

<section data-section="experience" id="experience" class="xp" aria-labelledby="experience-title">
  <h2 id="experience-title" class="sr-only">{m.xp_title({}, { locale })}</h2>
  <ol class="xp-list">
    {
      items.map((e, i) => (
        <li class="xp-item" style={`--i: ${i}`}>
          <span class="xp-year" aria-hidden="true">{e.year}</span>
          <h3 class="xp-company">
            {/* Desktop: a entrada abre no lugar. Celular: o nome é só texto; a gaveta tem o próprio botão. */}
            <button type="button" class="xp-toggle" aria-expanded="true" aria-controls={`xp-${e.id}-more`}>
              {e.company}
              <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M8 3.5v9M3.5 8h9" />
              </svg>
            </button>
            <span class="xp-plain">{e.company}</span>
            {e.current && (
              <>
                <span class="xp-dot" aria-hidden="true" />
                <span class="xp-now sr-only">{current}</span>
              </>
            )}
          </h3>
          <p class="xp-role">{e.role}</p>
          <p class="xp-period">{e.period}</p>
          <div class="xp-more" id={`xp-${e.id}-more`}>
            <p class="xp-summary">{e.summary}</p>
            <ul class="xp-stack">
              {e.stack.map((t) => (
                <li title={t.name}>{t.icon ? <Image src={t.icon} alt={t.name} width={24} height={24} /> : <span>{t.name}</span>}</li>
              ))}
            </ul>
          </div>
          <button type="button" class="xp-open" commandfor={`xp-${e.id}-drawer`} command="show-modal">
            {openLabel}
            <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
              <path d="M8 3.5v9M3.5 8h9" />
            </svg>
          </button>
          <Drawer id={`xp-${e.id}-drawer`} title={e.company} closeLabel={closeLabel}>
            <p class="xp-drawer-meta">{e.role} · {e.period}</p>
            <p class="xp-summary">{e.summary}</p>
            <ul class="xp-chips">
              {e.stack.map((t) => (
                <li>
                  {t.icon && <Image src={t.icon} alt="" width={18} height={18} />}
                  {t.name}
                </li>
              ))}
            </ul>
          </Drawer>
        </li>
      ))
    }
  </ol>
</section>

<script>
  // Abrir e fechar no lugar (desktop). No documento: sobrevive às trocas do ClientRouter e vale sem motion.
  document.addEventListener('click', (e) => {
    const toggle = (e.target as Element).closest?.('.xp-toggle')
    if (toggle) toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'))
  })
</script>

<style>
  .xp {
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
    padding: 10svh var(--gutter) 14svh;
  }
  .xp-list { display: grid; gap: clamp(4rem, 10svh, 7rem); }

  .xp-item {
    position: relative;
    max-width: 46rem;
    padding-top: clamp(70px, 13vw, 210px);
  }

  /* Tipo vazado: o preenchimento é o fundo de quem está atrás, para os traços sobrepostos não aparecerem. */
  .xp-year {
    position: absolute;
    top: 0;
    left: -0.04em;
    font: 800 clamp(120px, 22vw, 340px) / 0.8 var(--font-display);
    font-stretch: 75%;
    letter-spacing: -0.02em;
    color: var(--sheet, var(--bg));
    -webkit-text-stroke: 2px color-mix(in srgb, var(--line) 55%, var(--muted));
    paint-order: stroke fill;
    user-select: none;
  }

  .xp-company {
    position: relative;
    margin-bottom: 0.625rem;
    font: 700 clamp(2.25rem, 5vw, 4.5rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }
  /* Em linha: num nome que quebra, o sinal segue a última palavra. O tipo gigante garante o alvo de 44 px. */
  .xp-toggle {
    display: inline;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    touch-action: manipulation;
  }
  .xp-toggle svg {
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.15em;
    vertical-align: 0.1em;
    color: var(--muted);
    transition: rotate 300ms var(--ease), color 200ms ease;
  }
  .xp-toggle:hover svg { color: var(--accent); }
  .xp-toggle[aria-expanded="true"] svg { rotate: 45deg; color: var(--accent); }
  .xp-dot {
    display: inline-block;
    margin-left: 0.2em;
    vertical-align: 0.1em;
    width: 0.22em;
    height: 0.22em;
    border-radius: 50%;
    background: var(--accent);
  }

  .xp-role, .xp-period {
    position: relative;
    font-size: clamp(0.9375rem, 1.3vw, 1.125rem);
    color: var(--muted);
  }
  .xp-role { color: var(--ink); }

  /* O espaço do resumo fica sempre reservado: abrir e fechar não muda a altura. */
  .xp-more {
    position: relative;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    transition: opacity 300ms ease, translate 400ms var(--ease), visibility 0s;
  }
  .xp-item:has(.xp-toggle[aria-expanded="false"]) .xp-more {
    opacity: 0;
    translate: 0 0.75rem;
    visibility: hidden;
    transition: opacity 200ms ease, translate 300ms var(--ease), visibility 0s 300ms;
  }
  .xp-summary {
    max-width: 46rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .xp-stack { display: flex; flex-wrap: wrap; gap: 0.875rem; }
  .xp-stack li { display: grid; place-items: center; min-height: 1.5rem; font-size: 0.8125rem; color: var(--muted); }
  .xp-stack img { width: 1.5rem; height: 1.5rem; }

  .xp-open, .xp-plain { display: none; }

  /* Desktop com motion: trilho horizontal preso; experience.ts o move com o scroll. */
  @media (min-width: 768px) {
    :global(html.motion) .xp {
      display: grid;
      align-content: center;
      height: 100vh;
      padding: 0;
      overflow: clip;
    }
    :global(html.motion) .xp-list {
      display: flex;
      gap: 6vw;
      width: max-content;
      padding: 0 8vw;
    }
    :global(html.motion) .xp-item { flex: none; width: min(80vw, 46rem); }
  }

  /* Celular: folhas; com motion, cada uma gruda no topo e a anterior recua (experience.ts). */
  @media (max-width: 767.98px) {
    .xp { padding: 8svh var(--gutter) 12svh; }
    .xp-list { gap: 0; }
    .xp-item {
      --sheet: var(--bg);
      display: flex;
      flex-direction: column;
      min-height: 52svh;
      margin-bottom: 1.125rem;
      padding: clamp(1.375rem, 6vw, 2.5rem);
      border: 1px solid var(--line);
      border-radius: 1.75rem;
      background: var(--sheet);
      box-shadow: 0 -20px 40px -32px var(--shadow);
      transform-origin: 50% 0;
    }
    .xp-item:nth-child(even) { --sheet: color-mix(in srgb, var(--ink) 5%, var(--bg)); }
    :global(html.motion) .xp-item { position: sticky; top: calc(5rem + var(--i) * 0.875rem); }

    .xp-year {
      position: relative;
      left: -0.04em;
      margin-bottom: 1rem;
      font-size: clamp(6.5rem, 34vw, 10rem);
      -webkit-text-stroke-width: 1.5px;
    }
    .xp-company { font-size: clamp(2.25rem, 11vw, 3.25rem); }
    .xp-period { margin-bottom: 1.75rem; }
    .xp-toggle, .xp-more { display: none; }
    .xp-plain { display: inline; }
    .xp-open {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      gap: 0.5rem;
      min-height: 2.75rem;
      margin-top: auto;
      padding: 0 1.125rem;
      border: 1px solid var(--line);
      border-radius: 9999px;
      font: 500 0.9375rem/1 var(--font-sans);
      color: var(--ink);
      background: var(--sheet);
      cursor: pointer;
      touch-action: manipulation;
      transition: border-color 200ms ease;
    }
    .xp-open:hover { border-color: var(--ink); }
  }

  .xp-drawer-meta { margin-bottom: 0.75rem; font-weight: 500; }
  .xp-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  .xp-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 9999px;
    font-size: 0.8125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .xp-more, .xp-item:has(.xp-toggle[aria-expanded="false"]) .xp-more { translate: none; }
    .xp-toggle svg { transition: color 200ms ease; }
  }
</style>
