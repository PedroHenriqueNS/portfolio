---
import { Image } from 'astro:assets'
import * as m from '@/paraglide/messages.js'
import type { Locale } from '@/i18n/locales'
import photo from '@/assets/images/pedro.jpg'

interface Props {
  locale: Locale
  resumes: { href: string; text: string; label: string }[]
}

const { locale, resumes } = Astro.props
const name = m.hero_name({}, { locale })
// O tamanho do nome sai do número de letras: no desktop a linha enche a largura; no celular, cada palavra.
const [first, ...rest] = name.split(' ')
const last = rest.join(' ')
---

<section data-section="hero" id="hero" class="hero" style={`--chars: ${name.length}; --w1: ${first.length}; --w2: ${last.length}`}>
  <div class="hero-mark">
    <h1 class="hero-name" data-fit>
      <span class="hero-line">{first}</span>{' '}<span class="hero-line">{last}</span>
    </h1>
    <figure class="hero-card">
      <Image
        src={photo}
        alt={m.hero_photo_alt({}, { locale })}
        widths={[320, 480, 640]}
        sizes="(min-width: 768px) 260px, 40vw"
        loading="eager"
        fetchpriority="high"
        class="hero-photo"
      />
    </figure>
  </div>
  <div class="hero-foot">
    <p class="hero-role" data-fit>{m.hero_role({}, { locale })}</p>
    <ul class="hero-actions">
      {
        resumes.map((r, i) => (
          <li>
            <a href={r.href} type="application/pdf" aria-label={r.label} data-action class:list={['pill', { 'pill-main': i === 0 }]}>
              {r.text}
            </a>
          </li>
        ))
      }
      <li>
        <a href="#contact" data-action class="pill">{m.hero_cta_contact({}, { locale })}</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    /* --fit: avanço médio de um caractere, em em, na Bricolage a 75% de largura e peso 700 (medido no Chromium:
       0,408 com o espaço; 0,445 em "Pedro"). Um pouco acima do medido, para sobrar folga. */
    --fit: 0.415;
    position: relative;
    display: grid;
    min-height: calc(100svh - 4.75rem);
    align-content: end;
    padding: 0 var(--gutter) 6svh;
    overflow-x: clip;
    container-type: inline-size;
  }
  .hero-mark { position: relative; }

  .hero-name {
    margin: 0 0 3.5svh;
    font: 700 calc(100cqw / (var(--chars) * var(--fit))) / 0.82 var(--font-display);
    font-stretch: 75%;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
  .hero-line { display: inline-block; }

  .hero-card {
    position: absolute;
    right: 6%;
    bottom: 78%;
    z-index: 2;
    width: clamp(150px, 17vw, 260px);
    margin: 0;
    rotate: 5deg;
  }
  .hero-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px var(--shadow);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .hero-role { font: 500 clamp(1rem, 1.4vw, 1.1875rem) / 1.3 var(--font-sans); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 1px solid var(--ink);
    border-radius: 9999px;
    font: 500 0.9375rem/1 var(--font-sans);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .pill:hover { background: var(--ink); color: var(--bg); }
  .pill-main { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .pill-main:hover { background: var(--ink); border-color: var(--ink); }

  @media (max-width: 767.98px) {
    .hero {
      --fit: 0.45;
      align-content: center;
      gap: 2rem;
      padding-bottom: 4svh;
    }
    /* Duas linhas, cada uma do tamanho que a enche; a foto fica no vão entre elas. */
    .hero-name {
      display: grid;
      justify-items: center;
      row-gap: 48cqw;
      margin: 0;
      white-space: normal;
    }
    .hero-line:first-child { font-size: calc(100cqw / (var(--w1) * var(--fit))); }
    .hero-line:last-child { font-size: calc(100cqw / (var(--w2) * var(--fit))); }
    .hero-card {
      right: auto;
      bottom: auto;
      left: 30cqw;
      top: calc(0.82 * 100cqw / (var(--w1) * var(--fit)) - 4cqw);
      width: 40cqw;
      rotate: -4deg;
    }
    .hero-foot { display: grid; justify-items: center; text-align: center; }
    .hero-actions { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
    .hero-actions li:first-child { grid-column: 1 / -1; }
    .pill { width: 100%; }
  }
</style>
