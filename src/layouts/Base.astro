---
import { ClientRouter } from 'astro:transitions'
import '@/styles/global.css'
import Header from '@/components/Header.astro'
import { HREFLANG, HTML_LANG, LOCALES, OG_LOCALE, type Locale } from '@/i18n/locales'
import { alternates, pagePath } from '@/i18n/routes'
import { SITE, type Seo } from '@/lib/seo'

interface Props {
  seo: Seo
  locale: Locale
}

const { seo, locale } = Astro.props
// No build, Astro.url.pathname é o arquivo (/en.html); pagePath devolve o endereço (/en).
const path = pagePath(Astro.url.pathname)
const alts = alternates(path)
const url = `${SITE}${path}`
const json = JSON.stringify(seo.jsonLd).replace(/</g, '\\u003c')
---

<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#EEF0F3" />
    <!-- Tema antes da primeira pintura: o salvo pelo visitante, senão o do sistema (lógica de old/index.html). -->
    <script is:inline>
      (function () {
        function apply() {
          var dark
          try {
            var saved = localStorage.getItem('data-theme')
            dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches
          } catch (e) {
            dark = true
          }
          document.documentElement.classList.toggle('dark', dark)
          var meta = document.querySelector('meta[name="theme-color"]')
          if (meta) meta.setAttribute('content', dark ? '#060918' : '#EEF0F3')
        }
        apply()
        // O ClientRouter troca os atributos do <html> a cada navegação; reaplica antes da pintura.
        if (!window.__themeSwap) {
          window.__themeSwap = true
          document.addEventListener('astro:after-swap', apply)
        }
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content="Pedro Henrique do Nascimento Silva" />
    {seo.noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={`${SITE}${alts[l]}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${SITE}${alts['pt-br']}`} />
    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content="Pedro Henrique" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.imageAlt} />
    {
      seo.type === 'profile' ? (
        <>
          <meta property="profile:first_name" content="Pedro Henrique" />
          <meta property="profile:last_name" content="do Nascimento Silva" />
        </>
      ) : (
        <meta property="article:author" content={`${SITE}/`} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <script is:inline type="application/ld+json" set:html={json} />
    <ClientRouter />
  </head>
  <body>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
